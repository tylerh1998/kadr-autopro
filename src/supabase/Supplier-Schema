create table public."Supplier" (
  account_number text null,
  supid text null,
  address text null,
  default_gl_account bigint null,
  notes text null,
  town text null,
  pin_to_top boolean null,
  contact_person text null,
  default_taxable jsonb null,
  inventory_supplier boolean null,
  "LockedByUser" text null,
  province text null,
  phone text null,
  name text null,
  postal_code text null,
  email text null,
  id text not null,
  created_date timestamp with time zone null,
  updated_date timestamp with time zone null,
  created_by_id text null,
  created_by text null,
  is_sample boolean null,
  constraint Supplier_pkey primary key (id),
  constraint Supplier_id_key unique (id)
) TABLESPACE pg_default;
