create table public."SupplierInvoiceLine" (
  gst_amount numeric(10, 2) null,
  purchase_amount double precision null,
  inventory_item_id text null,
  paid_amount numeric(10, 2) null,
  description text null,
  gst_override boolean null,
  inventory boolean null,
  supplier_id text null,
  invoice_number text null,
  gl_account bigint null,
  invoice_date text null,
  inventory_credit boolean null,
  id text not null,
  created_date timestamp with time zone null,
  updated_date timestamp with time zone null,
  created_by_id text null,
  created_by text null,
  is_sample boolean null,
  constraint SupplierInvoiceLine_pkey primary key (id),
  constraint SupplierInvoiceLine_id_key unique (id)
) TABLESPACE pg_default;