{
  "name": "InventoryReturn",
  "type": "object",
  "properties": {
    "part_number": {
      "type": "string",
      "description": "Part number being returned"
    },
    "description": {
      "type": "string",
      "description": "Part description"
    },
    "supplier": {
      "type": "string",
      "description": "Supplier to return to"
    },
    "quantity_returned": {
      "type": "number",
      "description": "Quantity being returned"
    },
    "return_type": {
      "type": "string",
      "enum": [
        "core",
        "return",
        "warranty"
      ],
      "description": "Type of return"
    },
    "return_reason": {
      "type": "string",
      "description": "Reason for return"
    },
    "cost_per_unit": {
      "type": "number",
      "description": "Cost per unit of returned item"
    },
    "total_cost": {
      "type": "number",
      "description": "Total cost of returned items"
    },
    "return_date": {
      "type": "string",
      "format": "date",
      "description": "Date of return"
    },
    "work_order_id": {
      "type": "string",
      "description": "Related work order (if applicable)"
    },
    "inventory_item_id": {
      "type": "string",
      "description": "Related inventory item"
    },
    "status": {
      "type": "string",
      "enum": [
        "On-site",
        "Returned"
      ],
      "default": "On-site",
      "description": "Current status of the return"
    },
    "sent_back": {
      "type": "string",
      "default": "N/A",
      "description": "Date the item was sent back to supplier, or N/A if not yet sent"
    },
    "date_returned": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when status was changed to Returned"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes for the return"
    }
  },
  "required": [
    "part_number",
    "supplier",
    "quantity_returned",
    "return_type",
    "return_reason"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}