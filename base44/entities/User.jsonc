{
  "name": "User",
  "type": "object",
  "properties": {
    "User_name": {
      "type": "string",
      "description": "The name to display in the user menu"
    },
    "Initials": {
      "type": "string",
      "description": "User initials for the avatar"
    },
    "dark_mode": {
      "type": "boolean",
      "default": false,
      "description": "User preference for dark mode"
    },
    "OpenNewWindow": {
      "type": "boolean",
      "default": false,
      "description": "User preference for opening links in new windows"
    },
    "wo_cards": {
      "type": "boolean",
      "default": true,
      "description": "Display work orders as cards (true) or table (false)"
    },
    "access_level": {
      "type": "string",
      "enum": [
        "lvl1_user",
        "lvl2_user",
        "lvl3_user"
      ],
      "default": "lvl1_user",
      "description": "User access level"
    },
    "Paypro_user": {
      "type": "boolean",
      "default": false,
      "description": "If true, user can access Payroll page. If false/null, navigates to WorkPro."
    },
    "AcctsPayAccess": {
      "type": "boolean",
      "default": false,
      "description": "If true, user can view Cash Drawer and Cash Flow subitems in Accounting dropdown."
    }
  },
  "required": [
    "User_name",
    "Initials"
  ]
}