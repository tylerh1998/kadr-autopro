{
  "name": "Employee",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "Employee ID number"
    },
    "first_name": {
      "type": "string",
      "description": "First name"
    },
    "last_name": {
      "type": "string",
      "description": "Last name"
    },
    "full_name": {
      "type": "string",
      "description": "Full name from WorkPRO"
    },
    "email": {
      "type": "string",
      "description": "Email address from WorkPRO"
    },
    "position": {
      "type": "string",
      "enum": [
        "Technician",
        "Non-Technician"
      ],
      "description": "Job position"
    },
    "employee_type": {
      "type": "string",
      "description": "Employee type from WorkPRO (e.g., 'tech')"
    },
    "pay_rate": {
      "type": "number",
      "description": "Hourly pay rate"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Active employee"
    }
  },
  "required": [
    "employee_id",
    "first_name",
    "last_name",
    "position"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}