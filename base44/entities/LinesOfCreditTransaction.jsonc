{
  "name": "LinesOfCreditTransaction",
  "type": "object",
  "properties": {
    "line_of_credit_id": {
      "type": "string",
      "description": "Reference to lines of credit account"
    },
    "transaction_date": {
      "type": "string",
      "format": "date",
      "description": "Transaction date"
    },
    "description": {
      "type": "string",
      "description": "Transaction description"
    },
    "reference": {
      "type": "string",
      "description": "Reference number, confirmation code, etc."
    },
    "charge_amount": {
      "type": "number",
      "default": 0,
      "description": "Amount charged to line of credit (increases balance)"
    },
    "credit_amount": {
      "type": "number",
      "default": 0,
      "description": "Amount credited to line of credit (refunds, returns, manual credits - decreases balance)"
    },
    "payment_amount": {
      "type": "number",
      "default": 0,
      "description": "Amount paid against this charge transaction. On charge lines: reduces outstanding. On payment_made records: informational total."
    },
    "balance": {
      "type": "number",
      "description": "Running balance after transaction"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "manual",
        "supplier_payment",
        "supplier_credit",
        "inventory_return",
        "payment_made",
        "interest",
        "fee",
        "cashback"
      ],
      "description": "Source of the transaction"
    },
    "source_id": {
      "type": "string",
      "description": "ID of source record"
    },
    "payment_applied_data": {
      "type": "string",
      "description": "JSON string containing breakdown of where payment was applied: [{ id: 'tx_id', amount: 100.00 }]"
    },
    "is_reversed": {
      "type": "boolean",
      "default": false,
      "description": "Indicates if this transaction has been reversed"
    },
    "reversed_by_id": {
      "type": "string",
      "description": "ID of the transaction that reversed this one"
    }
  },
  "required": [
    "line_of_credit_id",
    "transaction_date",
    "description"
  ]
}