{
  "name": "Levies",
  "type": "object",
  "properties": {
    "date_applied": {
      "type": "string",
      "format": "date-time",
      "description": "Date the levy was applied"
    },
    "work_order_id": {
      "type": "string",
      "description": "ID of the work order"
    },
    "other_charge_id": {
      "type": "string",
      "description": "ID of the other charge type"
    },
    "line_item_id": {
      "type": "string",
      "description": "ID of the specific line item on the work order"
    },
    "qty": {
      "type": "number",
      "description": "Quantity of the levy"
    },
    "base_amount": {
      "type": "number",
      "description": "Base amount per unit"
    },
    "total_amount": {
      "type": "number",
      "description": "Total amount (qty * base_amount)"
    },
    "supplier_invoice_line_id": {
      "type": "string",
      "description": "ID of the supplier invoice line (if applicable)"
    }
  },
  "required": [
    "date_applied",
    "work_order_id",
    "other_charge_id",
    "line_item_id",
    "qty",
    "total_amount"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}