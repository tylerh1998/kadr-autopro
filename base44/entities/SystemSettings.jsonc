{
  "name": "SystemSettings",
  "type": "object",
  "properties": {
    "next_ro_number": {
      "type": "number",
      "default": 1001,
      "description": "The next available Repair Order number"
    },
    "next_inv_number": {
      "type": "number",
      "default": 1001,
      "description": "The next available Invoice number"
    },
    "wip_legal": {
      "type": "string",
      "description": "Legal text for work orders and invoices"
    },
    "default_message": {
      "type": "string",
      "description": "Default message for new work orders"
    },
    "shop_supply_rate": {
      "type": "number",
      "default": 0.06,
      "description": "Shop supply rate as decimal (e.g., 0.06 for 6%)"
    },
    "default_taxable": {
      "type": "boolean",
      "default": true,
      "description": "Default taxable status for line items"
    },
    "tax_rate": {
      "type": "number",
      "default": 0.05,
      "description": "Tax rate as decimal (e.g., 0.05 for 5%)"
    },
    "shop_supplies_gl_account": {
      "type": "string",
      "description": "GL account for shop supplies revenue"
    },
    "gst_collected_account_number": {
      "type": "string",
      "default": "2002",
      "description": "GL account number for GST collected from customers"
    },
    "gst_paid_account_number": {
      "type": "string",
      "default": "2003",
      "description": "GL account number for GST paid to suppliers"
    },
    "gst_payable_receivable_account_number": {
      "type": "string",
      "default": "2001",
      "description": "GL account number for net GST payable/receivable"
    },
    "kanban_view_1": {
      "type": "string",
      "description": "JSON string storing Kanban board view settings (column sizes, visibility, positions, card fields)"
    },
    "training_enviro": {
      "type": "boolean",
      "default": false,
      "description": "If true, displays a banner indicating this is a training environment"
    }
  },
  "required": []
}