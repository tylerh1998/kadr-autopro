{
  "name": "OtherChargeList",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Description of the other charge type"
    },
    "gl_account": {
      "type": "string",
      "description": "Default GL account number for this charge type"
    },
    "base_amount": {
      "type": "number",
      "description": "Default base amount for this charge type",
      "default": 0
    },
    "is_taxable": {
      "type": "boolean",
      "default": true,
      "description": "Whether this charge type is taxable by default"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this charge type is active"
    },
    "apply_cost": {
      "type": "boolean",
      "default": false,
      "description": "Whether a cost is applied to this charge type by default"
    },
    "linked_supplier_id": {
      "type": "string",
      "description": "Reference to a Supplier entity for default cost application"
    },
    "levy": {
      "type": "boolean",
      "default": false,
      "description": "If true, this charge is hidden from manual selection but can still be added as a tag-along"
    },
    "reportable_levy": {
      "type": "boolean",
      "default": false,
      "description": "If true, this charge is tracked as a reportable levy (e.g. tire tax)"
    }
  },
  "required": [
    "description",
    "gl_account"
  ]
}