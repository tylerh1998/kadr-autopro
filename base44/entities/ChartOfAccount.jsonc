{
  "name": "ChartOfAccount",
  "type": "object",
  "properties": {
    "account_number": {
      "type": "string",
      "description": "Account number (e.g., 1000, 5000)"
    },
    "account_name": {
      "type": "string",
      "description": "Account name"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "Asset",
        "Liability",
        "Equity",
        "Revenue",
        "Expense"
      ],
      "description": "Type of account"
    },
    "parent_account": {
      "type": "string",
      "description": "Parent account number if sub-account"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Account is active"
    },
    "controlled": {
      "type": "boolean",
      "default": false,
      "description": "Account is controlled"
    },
    "description": {
      "type": "string",
      "description": "Account description"
    }
  },
  "required": [
    "account_number",
    "account_name",
    "account_type"
  ]
}