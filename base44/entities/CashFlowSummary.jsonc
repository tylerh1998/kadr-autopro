{
  "name": "CashFlowSummary",
  "type": "object",
  "properties": {
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last update to summary data (in Mountain Time)"
    },
    "month_end": {
      "type": "string",
      "format": "date",
      "description": "Month end date for the summary period (in Mountain Time)"
    },
    "current_bank_balance": {
      "type": "number",
      "description": "Current balance in the bank account"
    },
    "upcoming_payroll": {
      "type": "number",
      "description": "Estimated upcoming payroll amount"
    },
    "payroll_remit": {
      "type": "number",
      "description": "Estimated payroll remittance amount"
    },
    "gst_remit": {
      "type": "number",
      "description": "Estimated GST remittance amount"
    },
    "fiscal_cushion": {
      "type": "number",
      "description": "Amount set aside as a fiscal cushion",
      "default": 1000
    },
    "expected_deposits": {
      "type": "number",
      "description": "Expected deposits amount"
    },
    "etransfer_per_tx": {
      "type": "number",
      "description": "Etransfer limit per transaction"
    },
    "etransfer_daily": {
      "type": "number",
      "description": "Daily etransfer limit"
    },
    "etransfer_weekly": {
      "type": "number",
      "description": "Weekly etransfer limit"
    },
    "etransfer_monthly": {
      "type": "number",
      "description": "Monthly etransfer limit"
    },
    "pad_registries_total": {
      "type": "number",
      "description": "Total PAD & Registries amount"
    },
    "pad_registries_details": {
      "type": "string",
      "description": "JSON string of PAD & Registries details: [{name, amount}]"
    },
    "overhead_items": {
      "type": "string",
      "description": "JSON string of overhead items: [{description, amount, date_option, method}]"
    },
    "est_first_payroll": {
      "type": "number",
      "description": "Estimate First Payroll"
    },
    "est_second_payroll": {
      "type": "number",
      "description": "Estimate Second Payroll"
    },
    "est_payroll_remit": {
      "type": "number",
      "description": "Estimate Payroll Remit"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}