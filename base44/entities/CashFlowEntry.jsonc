{
  "name": "CashFlowEntry",
  "type": "object",
  "properties": {
    "supplier_id": {
      "type": "string",
      "description": "Reference to the Supplier entity ID"
    },
    "loc_id": {
      "type": "string",
      "description": "Reference to the Line of Credit entity ID"
    },
    "supplier": {
      "type": "string",
      "description": "Supplier name"
    },
    "amount": {
      "type": "number",
      "description": "Total amount due for this entry"
    },
    "amount_paid": {
      "type": "number",
      "description": "Amount already paid for this entry",
      "default": 0
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Due date of the entry (in Mountain Time)"
    },
    "date_paid": {
      "type": "string",
      "format": "date",
      "description": "Date the entry was paid (in Mountain Time)"
    },
    "chq_number": {
      "type": "string",
      "description": "Cheque number if payment method is cheque"
    },
    "method": {
      "type": "string",
      "description": "Payment method"
    },
    "comment": {
      "type": "string",
      "description": "Notes or comments for the entry"
    },
    "bg_colour": {
      "type": "string",
      "description": "Background color for the row (e.g., hex code, CSS color name)"
    },
    "row_status": {
      "type": "string",
      "description": "Status of the row (e.g., 'paid', 'follow_up')"
    },
    "sort_order": {
      "type": "number",
      "description": "Order of the row in the table",
      "default": 0
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}