{
  "name": "BankReconciliation",
  "type": "object",
  "properties": {
    "bank_account_id": {
      "type": "string",
      "description": "Reference to the BankAccount entity that was reconciled"
    },
    "reconciliation_id": {
      "type": "string",
      "description": "Unique ID generated for this reconciliation (e.g., RECON-170101010101)"
    },
    "reconciliation_date": {
      "type": "string",
      "format": "date-time",
      "description": "The exact date and time the reconciliation was saved"
    },
    "period_start_date": {
      "type": "string",
      "format": "date",
      "description": "The start date of the period covered by this reconciliation"
    },
    "period_end_date": {
      "type": "string",
      "format": "date",
      "description": "The end date of the period covered by this reconciliation"
    },
    "statement_ending_balance": {
      "type": "number",
      "description": "The ending balance entered by the user from the bank statement"
    },
    "cleared_balance_at_reconciliation": {
      "type": "number",
      "description": "The calculated cleared balance of selected transactions at the time of reconciliation"
    },
    "difference": {
      "type": "number",
      "description": "The difference between statement_ending_balance and cleared_balance_at_reconciliation (should be 0 if enforced)"
    },
    "reconciled_by": {
      "type": "string",
      "description": "The email or ID of the user who performed the reconciliation"
    },
    "starting_balance": {
      "type": "number",
      "description": "The computed starting balance for the reconciliation period"
    },
    "total_credits": {
      "type": "number",
      "description": "Total credits of transactions included in this reconciliation"
    },
    "total_debits": {
      "type": "number",
      "description": "Total debits of transactions included in this reconciliation"
    }
  },
  "required": [
    "bank_account_id",
    "reconciliation_id",
    "reconciliation_date"
  ]
}