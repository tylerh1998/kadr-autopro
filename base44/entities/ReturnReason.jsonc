{
  "name": "ReturnReason",
  "type": "object",
  "properties": {
    "reason": {
      "type": "string",
      "description": "Return reason text"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether reason is active"
    },
    "hide": {
      "type": "boolean",
      "default": false,
      "description": "If true, reason will not appear in the return modal dropdown"
    }
  },
  "required": [
    "reason"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}