{
  "name": "BankAccount",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Bank account name"
    },
    "bank_name": {
      "type": "string",
      "description": "Name of the bank"
    },
    "account_number": {
      "type": "string",
      "description": "Bank account number"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "Checking",
        "Savings",
        "Credit Card",
        "Line of Credit",
        "Other"
      ],
      "description": "Type of bank account"
    },
    "current_balance": {
      "type": "number",
      "default": 0,
      "description": "Current account balance"
    },
    "gl_account": {
      "type": "string",
      "description": "Associated GL account number"
    },
    "routing_number": {
      "type": "string",
      "description": "Bank routing number"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Account is active"
    },
    "primary": {
      "type": "boolean",
      "default": false,
      "description": "Is this the primary bank account for default selections"
    },
    "notes": {
      "type": "string",
      "description": "Account notes"
    },
    "next_cheque_number": {
      "type": "number",
      "description": "The next cheque number to be used for this bank account",
      "default": 1
    },
    "last_recalculated_date": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last balance recalculation"
    },
    "locked_by_user": {
      "type": "string",
      "description": "Email of the user currently editing this bank account"
    },
    "locked_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the bank account was locked (stored in UTC)"
    }
  },
  "required": [
    "name",
    "bank_name",
    "account_type"
  ]
}