{
  "name": "PayrollTransaction",
  "type": "object",
  "properties": {
    "transaction_type": {
      "type": "string",
      "enum": [
        "Paycheque",
        "Remittance",
        "Adjustment"
      ],
      "description": "Type of payroll transaction"
    },
    "paycheque_number": {
      "type": "string",
      "description": "Unique paycheque number for cross-referencing with payroll program"
    },
    "pay_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the transaction (paycheque date, remittance date, or adjustment date)"
    },
    "is_bus_driver_wages": {
      "type": "boolean",
      "default": false,
      "description": "True if this paycheque is for bus driver wages, determining the expense account used"
    },
    "gross_pay": {
      "type": "number",
      "description": "Gross pay amount (for Paycheque and potentially Adjustment transactions)"
    },
    "income_tax": {
      "type": "number",
      "description": "Total income tax (Federal Tax + Provincial Tax)"
    },
    "cpp_contribution": {
      "type": "number",
      "description": "CPP (Canada Pension Plan) employee contribution amount"
    },
    "cpp2_contribution": {
      "type": "number",
      "description": "CPP2 (Canada Pension Plan 2) employee contribution amount"
    },
    "ei_premium": {
      "type": "number",
      "description": "EI (Employment Insurance) employee premium amount"
    },
    "cpp_employer": {
      "type": "number",
      "description": "CPP employer contribution amount"
    },
    "cpp2_employer": {
      "type": "number",
      "description": "CPP2 employer contribution amount"
    },
    "ei_employer": {
      "type": "number",
      "description": "EI employer premium amount (1.4x employee premium)"
    },
    "amount": {
      "type": "number",
      "description": "Transaction amount (for Remittance and Adjustment transactions)"
    },
    "paycheque_numbers_included": {
      "type": "string",
      "description": "Comma-separated list of paycheque numbers covered by this remittance"
    },
    "adjustment_reason": {
      "type": "string",
      "description": "Reason for the adjustment (for Adjustment transactions)"
    },
    "is_paid": {
      "type": "boolean",
      "default": false,
      "description": "Indicates whether this transaction has been paid/processed"
    },
    "employee_reference": {
      "type": "string",
      "description": "Non-identifiable reference to link to an employee (e.g., a unique hash or PayrollPro ID) - used for lookups without storing PII"
    },
    "import_file_name": {
      "type": "string",
      "description": "Name of the file this transaction was imported from (if applicable)"
    },
    "import_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time when this transaction was imported"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the transaction"
    },
    "remittance_period_start": {
      "type": "string",
      "format": "date",
      "description": "Start of the remittance period (for Remittance transactions)"
    },
    "remittance_period_end": {
      "type": "string",
      "format": "date",
      "description": "End of the remittance period (for Remittance transactions)"
    },
    "additional_deductions": {
      "type": "string",
      "description": "JSON string of additional deductions [{description, gl_account, amount}]"
    }
  },
  "required": [
    "transaction_type",
    "pay_date"
  ]
}